# RAG server runtime configuration.
#
# These are the variables server.js actually reads. In normal operation they
# are injected by docker-compose.yml (the `environment:` block), so this file
# is documentation / a template for running server.js outside Docker.

# HTTP port the RAG server listens on.
PORT=3000

# Upstream services.
OLLAMA_HOST=http://127.0.0.1:11434
CHROMA_URL=http://127.0.0.1:8000

# Root directory scanned for collections. Each immediate subfolder of DATA_DIR
# (e.g. ieee/, amd/) is one collection; PDFs go directly inside those folders.
# In Docker this is /data (./data mounted read-only).
DATA_DIR=/data

# Models pulled by scripts/bootstrap-models.sh.
EMBEDDING_MODEL=nomic-embed-text
# Two generation profiles (see design.md §5.3 for the benchmark behind this).
# Pick per request via the OpenAI `model` field: "amd" = fast, "amd!deep" =
# CHAT_MODEL_DEEP. Open WebUI lists both; MCP query_pdfs has a `deep` flag.
#  CHAT_MODEL (fast)  – gemma4:e4b: ~50s, fits 16GB fully (GPU-resident),
#       lowest hallucination risk (honestly flags doc gaps), shallower depth.
#  CHAT_MODEL_DEEP    – qwen2.5-coder:32b: best local accuracy on technical
#       docs, no glitches; >16GB VRAM so CPU-offloaded → ~5 min/answer.
# Other pulled options: deepseek-r1:14b (~30s, confident-error risk),
#  gemma4:26b (~3min, confident-error risk), llama3.1:8b (fastest, weakest).
# NOTE: leetllm's temperature=1.0 Gemma rec is for general/thinking use — for
# this grounded RAG path keep generation low-temp; do not copy it blindly.
CHAT_MODEL=gemma4:e4b
CHAT_MODEL_DEEP=qwen2.5-coder:32b-instruct-q4_K_M

# Ollama context window for the chat model. Must hold TOP_K source chunks +
# the question + the answer; Ollama's own default (~2-4k) silently truncates
# the retrieved sources on long questions and causes weak/abstaining answers.
CHAT_NUM_CTX=12288
# Context for the !deep profile. Keep modest for a CPU-offloaded deep model
# so latency doesn't balloon. Defaults to CHAT_NUM_CTX.
CHAT_NUM_CTX_DEEP=12288

# Chunking and retrieval. CHUNK_OVERLAP must be < CHUNK_SIZE
# (it is clamped automatically if not). CHUNK_SIZE also caps embed input;
# EMBED_MAX_CHARS is the hard ceiling (oversized tables are row-split).
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBED_MAX_CHARS=1600
# Clause-bounded chunking: text packing never crosses a PDF bookmark boundary
# (section_path truncated to this outline depth), keeping every chunk
# clause-pure so vocabulary-colliding mechanisms don't share a chunk. 0 = off.
CHUNK_CLAUSE_DEPTH=3
TOP_K_RESULTS=8
# Retrieved chunks for the !deep profile (more context for the stronger model).
TOP_K_DEEP=15

# Cross-encoder reranker sidecar (docker-compose `reranker` service). After
# hybrid+dedupe, the top RERANK_CANDIDATES are reordered so the right clause
# beats vocabulary-colliding distractors (e.g. IEEE 802.1Q TAS transmission
# gate vs PSFP stream gate). Empty RERANKER_URL = disabled (keep fused order);
# if the sidecar is down the RAG server degrades gracefully to fused order.
RERANKER_URL=http://127.0.0.1:8008/rerank
RERANK_CANDIDATES=30

# Near-duplicate handling: this corpus has the consolidated standard plus
# amendments — the same text recurs in several files. When near-identical
# chunks collide, keep the one from the earliest-listed preferred file
# (so citations point at the current consolidated standard, not a
# superseded amendment). 2026-05-25: IEEE 802.1Q canonical switched from
# `8021Q-2022` to `8802-1Q-2024` (ISO/IEC/IEEE 8802-1Q:2024 — the 3rd
# edition incorporating Qcw-2023 and Qdx-2024).
CANONICAL_PREFERENCE=8802-1Q-2024,ug1399-vitis-hls-en-us-2025.2

# Grounding mode:
#  strict    – answer ONLY from retrieved sources (max provenance; vague where
#              docs are silent; zero hallucination).
#  augmented – sources are primary + cited, but the model may add general
#              expertise for gaps, explicitly tagged and never falsely cited
#              (NotebookLM-like depth, looser provenance).
RAG_GROUNDING=augmented

# Ingest new/changed PDFs in every collection on server start.
AUTO_INGEST=true

# Default active collection. Empty = first collection folder alphabetically.
DEFAULT_COLLECTION=

# Optional shared secret. When set, every endpoint except /health requires
# `Authorization: Bearer <key>` (or an `x-api-key` header). Leave empty to
# run unauthenticated (localhost-only use). If set, Open WebUI's OpenAI
# connection API key and the MCP server's RAG_API_KEY must match this value.
RAG_API_KEY=
