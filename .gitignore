# Secrets
.env
.env.local
*.env

# Dependencies
node_modules/
**/node_modules/

# Python venvs / caches
**/.venv/
**/.venv-nemo/
**/__pycache__/
*.pyc

# RAG corpus + derived state (PDFs are copyright-restricted; DB is local state)
# Ignore the CONTENTS of each collection (PDFs, source, .rag-cache,
# .rag-images, .rag-md) but keep the folders themselves so collection
# placeholders + the seed configs below can be tracked.
data/*/*
!data/*/.gitkeep
# Source-tree RAG seed configs ARE committed (they describe the remote +
# ref + sparse-paths for a code collection; the clone itself is gitignored
# under storage/code-cache/).
!data/*/.git-source.yaml
storage/

# Benchmark run outputs (the scripts + prompts.json are committed; results aren't)
scripts/benchmark/results/
scripts/code-bench/results/

# XTAB conformance-audit working output (local audit artefacts; read-only XTAB
# tree is external, these are regenerable per-spec analysis files)
xtab-files/

# SearXNG generated state (settings.yml IS committed; runtime artefacts aren't)
searxng/secret_key
searxng/uwsgi.ini
searxng/state/

# Source-tree RAG: cloned repos for "link-mode" code collections live here
# (machine-local; reproducible from data/<name>/.git-source.yaml configs)
storage/code-cache/

# Editor / OS
.vscode/*
!.vscode/mcp.json
!.vscode/settings.json
.DS_Store
Thumbs.db
*.swp

# Claude Code per-machine settings (permissions, hooks, env). Project-shared
# settings (if any) go in .claude/settings.json which IS committed.
.claude/settings.local.json
# Machine-local runtime locks (scheduled-tasks lock holds a live PID/session)
.claude/*.lock
