# Secrets
.env
.env.local
*.env

# Dependencies
node_modules/
**/node_modules/

# Python venvs / caches
**/.venv/
**/.venv-nemo/
**/__pycache__/
*.pyc

# RAG corpus + derived state (PDFs are copyright-restricted; DB is local state)
data/*/
!data/*/.gitkeep
storage/

# Benchmark run outputs (the scripts + prompts.json are committed; results aren't)
scripts/benchmark/results/

# Editor / OS
.vscode/*
!.vscode/mcp.json
!.vscode/settings.json
.DS_Store
Thumbs.db
*.swp

# Claude Code per-machine settings (permissions, hooks, env). Project-shared
# settings (if any) go in .claude/settings.json which IS committed.
.claude/settings.local.json
